<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.audino.controller.AppShellController"
            style="-fx-background-color: -color-bg;" prefWidth="1280.0" prefHeight="760.0">

    <!-- Left Navigation Rail -->
    <left>
        <VBox prefWidth="250.0" minWidth="230.0" style="-fx-background-color: -color-nav-bg; -fx-padding: 16px 12px;" spacing="14">

            <!-- Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8px 6px;">
                <StackPane style="-fx-background-color: #14B8A6; -fx-background-radius: 8px; -fx-pref-width: 32px; -fx-pref-height: 32px;">
                    <FontIcon iconLiteral="mdi2s-shield-cross" iconSize="20" iconColor="#071720" />
                </StackPane>
                <VBox spacing="1">
                    <Label text="AUDINO" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #FFFFFF; -fx-letter-spacing: 1px;" />
                    <Label text="EMR &amp; SAFETY RADAR" style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #5EEAD4; -fx-letter-spacing: 0.8px;" />
                </VBox>
            </HBox>

            <!-- User Profile Box -->
            <VBox fx:id="userProfileBox" alignment="CENTER_LEFT" spacing="6"
                  style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-radius: 10px;">
                <Label fx:id="userNameLabel" text="Loading Staff..."
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" />
                <HBox fx:id="userRoleContainer" alignment="CENTER_LEFT" />
            </VBox>

            <Separator style="-fx-opacity: 0.15;" />

            <!-- Navigation Links -->
            <VBox fx:id="navContainer" spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboardBtn" text="Dashboard Home" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-nav-text; -fx-font-size: 13px; -fx-font-weight: 500; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="18" iconColor="#2DD4BF" />
                    </graphic>
                </Button>

                <Button fx:id="navConsultationBtn" text="Doctor Consultation" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-nav-text; -fx-font-size: 13px; -fx-font-weight: 500; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-stethoscope" iconSize="18" iconColor="#2DD4BF" />
                    </graphic>
                </Button>

                <Button fx:id="navQueueBtn" text="Queue &amp; Triage" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-nav-text; -fx-font-size: 13px; -fx-font-weight: 500; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-clipboard-account" iconSize="18" iconColor="#38BDF8" />
                    </graphic>
                </Button>

                <Button fx:id="navAdminBtn" text="Administration Portal" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-nav-text; -fx-font-size: 13px; -fx-font-weight: 500; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-shield-account" iconSize="18" iconColor="#FB923C" />
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Separator style="-fx-opacity: 0.15;" />

                <Button fx:id="navKioskBtn" text="Patient Kiosk Mode" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-background-radius: 8px; -fx-padding: 8px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2t-tablet" iconSize="16" iconColor="#94A3B8" />
                    </graphic>
                </Button>

                <Button fx:id="themeToggleBtn" text="Toggle Dark Mode" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-nav-text; -fx-font-size: 12px; -fx-background-radius: 8px; -fx-padding: 8px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2t-theme-light-dark" iconSize="16" iconColor="#E2E8F0" />
                    </graphic>
                </Button>

                <Button fx:id="logoutBtn" text="Sign Out" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #F87171; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi2l-logout" iconSize="16" iconColor="#F87171" />
                    </graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- Top Status Bar & Center Dynamic View -->
    <center>
        <BorderPane>
            <!-- Top Status Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: -color-surface; -fx-border-color: -color-border; -fx-border-width: 0 0 1px 0; -fx-padding: 12px 24px;">

                    <VBox spacing="1">
                        <Label fx:id="pageTitleLabel" text="Doctor Consultation"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -color-text;" />
                        <Label fx:id="breadcrumbLabel" text="Active Outpatient Prescribing"
                               style="-fx-font-size: 11px; -fx-text-fill: -color-text-secondary;" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Quick Command Palette Button -->
                    <Button fx:id="commandPaletteBtn" text="Search anything... (Ctrl + K)"
                            style="-fx-background-color: -color-surface-alt; -fx-text-fill: -color-text-secondary; -fx-border-color: -color-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 6px 14px; -fx-font-size: 11px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="mdi2m-magnify" iconSize="14" iconColor="#64748B" />
                        </graphic>
                    </Button>

                    <Label fx:id="liveClockLabel" text="Clock..."
                           style="-fx-font-size: 12px; -fx-font-weight: 500; -fx-text-fill: -color-text-muted;" />
                </HBox>
            </top>

            <!-- Center Content Swap Area (Direct Stretch for full 1366x768 responsiveness) -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: -color-bg; -fx-padding: 16px;">
                    <!-- Pages swap in here dynamically -->
                </StackPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>
