<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import com.audino.ui.components.SearchField?>
<?import com.audino.ui.components.Chip?>

<StackPane fx:id="receptionistRoot" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.audino.controller.ReceptionistController"
           style="-fx-background-color: transparent;">

    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="16" style="-fx-padding: 4px;">

            <!-- TOP: LIVE QUEUE SUMMARY & KPI STATS (4 Equal-Width Columns) -->
            <GridPane fx:id="receptionKpiContainer" hgap="16" vgap="16" minHeight="-Infinity" />

            <!-- MAIN SPLIT WORKSPACE -->
            <HBox spacing="18" VBox.vgrow="ALWAYS">

                <!-- LEFT PANEL: PATIENT REGISTRATION INTAKE WIZARD -->
                <VBox prefWidth="410.0" minWidth="380.0" spacing="16" styleClass="surface-card">
                    <Label text="NEW PATIENT INTAKE &amp; TRIAGE" styleClass="card-title" />

                    <!-- Stepper Component Node Container -->
                    <VBox fx:id="stepperContainer" alignment="CENTER" spacing="8" minHeight="-Infinity" />

                    <Separator style="-fx-opacity: 0.3;" />

                    <!-- STEP 1: DETAILS (DEMOGRAPHICS) -->
                    <VBox fx:id="step1Box" spacing="12">
                        <GridPane hgap="10" vgap="10">
                            <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <TextField fx:id="firstNameField" promptText="First legal name" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" />

                            <Label text="Last Name:" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <TextField fx:id="lastNameField" promptText="Last legal name" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" />

                            <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <DatePicker fx:id="dobPicker" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                            <Label text="Gender:" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <ComboBox fx:id="genderCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Phone Number (10 digits):" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <TextField fx:id="phoneField" promptText="e.g. 9820112345" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2" />

                            <Label text="Home Residential Address:" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <TextArea fx:id="addressArea" promptText="Flat / Street / City" prefRowCount="2" GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2" />
                        </GridPane>
                    </VBox>

                    <!-- STEP 2: MEDICAL HISTORY (ALLERGIES & CONDITIONS) -->
                    <VBox fx:id="step2Box" spacing="14" visible="false" managed="false">
                        <Label text="Known Drug &amp; Substance Allergies:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: -color-critical;" />
                        <Label text="Enter any drug allergies. Critical alerts will warn physicians against contraindicated prescribing." style="-fx-font-size: 11px; -fx-text-fill: -color-text-secondary;" wrapText="true" />
                        <VBox fx:id="allergyTagContainer" />

                        <Separator style="-fx-opacity: 0.3;" />

                        <Label text="Pre-existing Chronic Medical Conditions:" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: -color-warning;" />
                        <Label text="Enter diagnosed medical conditions (e.g. Hypertension, Peptic Ulcer, Diabetes, Asthma)." style="-fx-font-size: 11px; -fx-text-fill: -color-text-secondary;" wrapText="true" />
                        <VBox fx:id="conditionTagContainer" />
                    </VBox>

                    <!-- STEP 3: BASELINE VITALS & BMI CALCULATION -->
                    <VBox fx:id="step3Box" spacing="12" visible="false" managed="false">
                        <Label text="Triage Vital Signs &amp; Anthropometrics:" style="-fx-font-weight: bold; -fx-font-size: 12px;" />

                        <GridPane hgap="10" vgap="8">
                            <Label text="Height (cm):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="heightField" promptText="e.g. 172" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                            <Label text="Weight (kg):" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="weightField" promptText="e.g. 70" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Systolic BP (mmHg):" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="sysBpField" promptText="e.g. 120" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                            <Label text="Diastolic BP (mmHg):" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="diaBpField" promptText="e.g. 80" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Pulse (bpm):" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="pulseField" promptText="e.g. 72" GridPane.columnIndex="0" GridPane.rowIndex="5" />

                            <Label text="Temperature (C):" GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="tempField" promptText="e.g. 36.8" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                            <Label text="SpO2 (%):" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                            <TextField fx:id="spo2Field" promptText="e.g. 98" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        </GridPane>

                        <!-- Real-time BMI Display Card -->
                        <HBox alignment="CENTER_LEFT" spacing="10"
                              style="-fx-background-color: -color-surface-alt; -fx-border-color: -color-border; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;">
                            <Label fx:id="bmiDisplayLabel" text="BMI: --" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;" />
                            <Label fx:id="bmiCategoryLabel" text="" style="-fx-font-size: 13px;" />
                        </HBox>
                    </VBox>

                    <!-- STEP 4: TOKEN ISSUANCE CONFIRMATION -->
                    <VBox fx:id="step4Box" spacing="14" visible="false" managed="false">
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="selected-patient-card">
                            <FontIcon iconLiteral="mdi2c-check-circle" iconSize="24" style="-fx-icon-color: -color-primary;" />
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Patient Registration Complete" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: -color-text;" />
                                <Label fx:id="step4SummaryLabel" text="Patient record saved and selected for queue token." style="-fx-font-size: 12px; -fx-text-fill: -color-text-secondary;" wrapText="true" />
                            </VBox>
                        </HBox>

                        <Label text="The patient is pre-selected in the Issue Outpatient Queue Token panel. You can assign a physician and issue a consultation token directly below or from the right panel."
                               style="-fx-font-size: 12px; -fx-text-fill: -color-text-secondary;" wrapText="true" />

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Register Another Patient" onAction="#handleStartNewRegistration" styleClass="btn-secondary" />
                            <Button fx:id="wizardIssueTokenBtn" text="Issue Token Now" onAction="#handleIssueToken" styleClass="btn-primary">
                                <graphic>
                                    <FontIcon iconLiteral="mdi2t-ticket-confirmation" iconSize="16" style="-fx-icon-color: -color-primary-contrast;" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Wizard Navigation Buttons -->
                    <HBox fx:id="wizardNavBox" spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="stepBackBtn" text="Back" onAction="#handleBackStep" styleClass="btn-secondary" />
                        <Button fx:id="stepNextBtn" text="Next Step" onAction="#handleNextStep" styleClass="btn-primary" />
                        <Button fx:id="registerPatientBtn" text="Complete Registration" onAction="#handleRegisterPatient"
                                style="-fx-background-color: -color-success; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 16px; -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <!-- RIGHT PANEL: QUEUE MANAGEMENT & LIVE TOKEN LIST -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="480.0">

                    <!-- Issue Token Card -->
                    <VBox styleClass="surface-card" spacing="12" minHeight="-Infinity">
                        <Label text="ISSUE OUTPATIENT QUEUE TOKEN" styleClass="card-title" />

                        <!-- Row 1: Full-width Patient Search -->
                        <SearchField fx:id="patientSearchField" promptText="Search registered patients by name, ID, or phone..." maxWidth="Infinity" />

                        <!-- Row 2: Doctor Dropdown (grows) + Issue Token Button with icon -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ComboBox fx:id="doctorAssignCombo" maxWidth="Infinity" minWidth="180.0" HBox.hgrow="ALWAYS" />
                            <Button fx:id="issueTokenBtn" text="Issue Token" minWidth="-Infinity" onAction="#handleIssueToken" disable="true" styleClass="btn-primary">
                                <graphic>
                                    <FontIcon iconLiteral="mdi2t-ticket-confirmation" iconSize="16" style="-fx-icon-color: -color-primary-contrast;" />
                                </graphic>
                            </Button>
                        </HBox>

                        <!-- Selected Patient Highlighted Card OR Guidance Prompt -->
                        <Label fx:id="selectedPatientPrompt" text="Search for a patient above or complete registration on the left to issue a token."
                               style="-fx-font-size: 12px; -fx-text-fill: -color-text-muted;" wrapText="true" />

                        <HBox fx:id="selectedPatientBox" spacing="10" alignment="CENTER_LEFT" styleClass="selected-patient-card" visible="false" managed="false">
                            <FontIcon iconLiteral="mdi2a-account-check" iconSize="20" style="-fx-icon-color: -color-primary;" />
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="selectedPatientNameLabel" text="Patient Name" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: -color-text;" />
                                <Label fx:id="selectedPatientMetaLabel" text="ID &amp; Phone" style="-fx-font-size: 11px; -fx-text-fill: -color-text-secondary;" />
                            </VBox>
                            <Button fx:id="clearSelectedPatientBtn" text="Clear" onAction="#handleClearSelectedPatient" styleClass="btn-ghost" minWidth="-Infinity" />
                        </HBox>

                        <!-- Search Results Inline Table (visible during active search) -->
                        <TableView fx:id="patientSearchResultTable" prefHeight="135.0" styleClass="data-table" visible="false" managed="false">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="patColId" text="Patient ID" prefWidth="110.0" minWidth="90.0" />
                                <TableColumn fx:id="patColName" text="Full Name" prefWidth="210.0" minWidth="140.0" />
                                <TableColumn fx:id="patColPhone" text="Phone" prefWidth="140.0" minWidth="110.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Live Outpatient Queue -->
                    <VBox styleClass="surface-card" spacing="12" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="TODAY'S LIVE CONSULTATION QUEUE" styleClass="card-title" HBox.hgrow="ALWAYS" />
                            <Chip text="OBSERVER ACTIVE" variant="SUCCESS" iconLiteral="mdi2r-radio-tower" />
                        </HBox>

                        <TableView fx:id="queueTable" VBox.vgrow="ALWAYS" minHeight="240.0" styleClass="data-table">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="queueColToken" text="Token #" prefWidth="60.0" minWidth="50.0" />
                                <TableColumn fx:id="queueColTime" text="Issued" prefWidth="70.0" minWidth="60.0" />
                                <TableColumn fx:id="queueColPatient" text="Patient Name" prefWidth="112.0" minWidth="85.0" />
                                <TableColumn fx:id="queueColDoctor" text="Doctor" prefWidth="106.0" minWidth="82.0" />
                                <TableColumn fx:id="queueColStatus" text="Queue Status" prefWidth="122.0" minWidth="105.0" />
                                <TableColumn fx:id="queueColActions" text="Actions" prefWidth="98.0" minWidth="88.0" />
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>
    </ScrollPane>

</StackPane>
